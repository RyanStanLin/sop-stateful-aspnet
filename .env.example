ASPNETCORE_URLS=http://localhost:8080
# Copy to ignored .env.local; enable only when local PostgreSQL/Redis are running.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=app
# DATABASE_USER=app
# DATABASE_PASSWORD=replace-with-your-local-postgres-password
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-your-local-redis-password
# API_TOKEN=replace-with-a-local-random-token
# CONFIG_PATH=./local-data/config.json
