{
  "schemaVersion": 1,
  "name": "auto",
  "state": "present",
  "deployBranch": "main",
  "services": {
    "direct": {
      "type": "web",
      "build": {
        "context": "examples/performance",
        "dockerfile": "examples/performance/Dockerfile"
      },
      "port": 8080,
      "domain": "perf-single.ryanl.in",
      "health": {
        "path": "/healthz",
        "status": 200
      },
      "resources": {
        "memoryMiB": 96,
        "cpu": 0.5,
        "pids": 128
      },
      "environment": {
        "PERF_ROLE": "owner"
      }
    },
    "owner": {
      "type": "web",
      "build": {
        "context": "examples/performance",
        "dockerfile": "examples/performance/Dockerfile"
      },
      "port": 8080,
      "domain": "perf-shared.ryanl.in",
      "health": {
        "path": "/healthz",
        "status": 200
      },
      "resources": {
        "memoryMiB": 96,
        "cpu": 0.5,
        "pids": 128
      },
      "environment": {
        "PERF_ROLE": "owner"
      },
      "routing": {
        "sharedGroup": "perf-shared"
      }
    },
    "peer": {
      "type": "web",
      "build": {
        "context": "examples/performance",
        "dockerfile": "examples/performance/Dockerfile"
      },
      "port": 8080,
      "domain": "perf-shared.ryanl.in",
      "health": {
        "path": "/healthz",
        "status": 200
      },
      "resources": {
        "memoryMiB": 96,
        "cpu": 0.5,
        "pids": 128
      },
      "environment": {
        "PERF_ROLE": "peer"
      },
      "routing": {
        "sharedGroup": "perf-shared"
      }
    }
  }
}
